@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix opts: <http://lv2plug.in/ns/ext/options#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .

<https://github.com/tylorismusic-commits/ember>
	a lv2:Plugin ;
	lv2:binary <ember.so> ;
	rdfs:seeAlso <ember.ttl> ;
	ui:ui <https://github.com/tylorismusic-commits/ember#ui> .

<https://github.com/tylorismusic-commits/ember#ui>
	a ui:X11UI ;
	ui:binary <emberUI.so> ;
	lv2:requiredFeature ui:idleInterface , ui:parent ;
	lv2:optionalFeature ui:resize , opts:options ;
	lv2:extensionData ui:idleInterface , ui:resize ;
	opts:supportedOption ui:scaleFactor ;
	rdfs:seeAlso <ember.ttl> .

<https://github.com/tylorismusic-commits/ember#preset_touch>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/ember> ;
	rdfs:seeAlso <presets.ttl> .

<https://github.com/tylorismusic-commits/ember#preset_vocal>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/ember> ;
	rdfs:seeAlso <presets.ttl> .

<https://github.com/tylorismusic-commits/ember#preset_mix_bus>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/ember> ;
	rdfs:seeAlso <presets.ttl> .

<https://github.com/tylorismusic-commits/ember#preset_drum_bus>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/ember> ;
	rdfs:seeAlso <presets.ttl> .

<https://github.com/tylorismusic-commits/ember#preset_master>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/ember> ;
	rdfs:seeAlso <presets.ttl> .

<https://github.com/tylorismusic-commits/ember#preset_broken>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/ember> ;
	rdfs:seeAlso <presets.ttl> .
