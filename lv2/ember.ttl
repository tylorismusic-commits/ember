@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix idpy: <http://harrisonconsoles.com/lv2/inlinedisplay#> .
@prefix opts: <http://lv2plug.in/ns/ext/options#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

@prefix ember: <https://github.com/tylorismusic-commits/ember> .

<https://github.com/tylorismusic-commits/ember>
	a lv2:Plugin ,
		lv2:CompressorPlugin ;
	lv2:binary <ember.so> ;
	lv2:majorVersion 0 ;
	lv2:minorVersion 1 ;
	lv2:microVersion 0 ;
	lv2:project <https://github.com/tylorismusic-commits/ember> ;
	lv2:optionalFeature lv2:hardRTCapable , idpy:queue_draw , idpy:in_gui ;
	lv2:extensionData idpy:interface ;
	doap:license <https://spdx.org/licenses/GPL-3.0-or-later.html> ;
	doap:name "Ember" ;
	doap:description "One-knob mastering finish: EQ, glue compression and harmonic sheen in a single control." ;
	doap:shortdesc "One-knob mastering EQ, compression and harmonic finish." ;
	foaf:homepage <https://github.com/tylorismusic-commits/ember> ;
	ui:ui <https://github.com/tylorismusic-commits/ember#ui> ;
	lv2:port
		[
			a lv2:AudioPort ,
			lv2:InputPort ;
			lv2:index 0 ;
			lv2:symbol "in_l" ;
			lv2:name "Input Left" ;
			pg:group <ember#input> ;
			lv2:designation pg:left ;
			lv2:documentation "Left input of the mastering chain." ;
			] ,
		[
			a lv2:AudioPort ,
			lv2:InputPort ;
			lv2:index 1 ;
			lv2:symbol "in_r" ;
			lv2:name "Input Right" ;
			pg:group <ember#input> ;
			lv2:designation pg:right ;
			lv2:documentation "Right input of the mastering chain." ;
			] ,
		[
			a lv2:AudioPort ,
			lv2:OutputPort ;
			lv2:index 2 ;
			lv2:symbol "out_l" ;
			lv2:name "Output Left" ;
			pg:group <ember#output> ;
			lv2:designation pg:left ;
			lv2:documentation "Left output of the mastering chain." ;
			] ,
		[
			a lv2:AudioPort ,
			lv2:OutputPort ;
			lv2:index 3 ;
			lv2:symbol "out_r" ;
			lv2:name "Output Right" ;
			pg:group <ember#output> ;
			lv2:designation pg:right ;
			lv2:documentation "Right output of the mastering chain." ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 4 ;
			lv2:symbol "amount" ;
			lv2:name "Amount" ;
			lv2:group <ember#finish> ;
			lv2:default 0 ;
			lv2:minimum 0 ;
			lv2:maximum 100 ;
			units:unit units:pc ;
			lv2:documentation "The single finish control.  At 0 the chain is neutral; as it rises, low-end weight, upper-mid presence, air, glue compression and harmonic sheen come in at different points in the travel." ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 5 ;
			lv2:symbol "enable" ;
			lv2:name "Enabled" ;
			lv2:group <ember#global> ;
			lv2:default 1 ;
			lv2:minimum 0 ;
			lv2:maximum 1 ;
			lv2:portProperty lv2:integer ,
			lv2:toggled ;
			lv2:documentation "Master bypass.  Bypass is a clean dry path." ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:OutputPort ;
			lv2:index 6 ;
			lv2:symbol "gr_meter" ;
			lv2:name "Gain Reduction" ;
			lv2:group <ember#global> ;
			lv2:default 0 ;
			lv2:minimum -60 ;
			lv2:maximum 0 ;
			units:unit units:db ;
			lv2:documentation "Gain reduction applied by the glue compressor, in dB (negative)." ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:OutputPort ;
			lv2:index 7 ;
			lv2:symbol "out_meter" ;
			lv2:name "Output Level" ;
			lv2:group <ember#global> ;
			lv2:default -60 ;
			lv2:minimum -60 ;
			lv2:maximum 6 ;
			units:unit units:db ;
			lv2:documentation "Peak output level in dBFS of the last block." ;
			] .

# Audio input / output groups
<ember#input>
	a pg:Group ;
	lv2:name "Input" ;
	lv2:symbol "input" ;
	.

<ember#output>
	a pg:Group ;
	lv2:name "Output" ;
	lv2:symbol "output" ;
	.

<ember#finish>
	a pg:Group ;
	lv2:name "Finish" ;
	lv2:symbol "finish" ;
	.

<ember#global>
	a pg:Group ;
	lv2:name "Global" ;
	lv2:symbol "global" ;
	.

<ember#ui>
	a ui:X11UI ;
	ui:binary <emberUI.so> ;
	lv2:requiredFeature ui:idleInterface , ui:parent ;
	lv2:optionalFeature ui:resize , opts:options ;
	lv2:extensionData ui:idleInterface , ui:resize ;
	opts:supportedOption ui:scaleFactor ;
	ui:portNotification [
			ui:plugin <https://github.com/tylorismusic-commits/ember> ;
			ui:portIndex 6 ;
	] , [
			ui:plugin <https://github.com/tylorismusic-commits/ember> ;
			ui:portIndex 7 ;
	] ;
	.
